---
import Jaali from './Jaali.astro';
import { site, links, wallThreads } from '../data/site';
// The finale: the same wall as the hero, every red thread tied, plus one pink thread left for the visitor.
const nodes = ['1,1', '3,1', '5,2', '7,1', '9,1', '11,2', '2,2', '4,2', '10,1'];
const lens = [1.3, 1.7, 1.1, 1.5, 1.2, 1.4, 1.0, 1.6, 1.8];
---
<footer class="s contact" id="contact" data-tone="cream" data-threads>
  <Jaali id="contact-wall" cols={12} rows={2} phoneCols={6} class="contact__wall" />
  {wallThreads.map((t, i) => (
    <span class="tag tag--quiet" data-hang="contact-wall" data-node={nodes[i % nodes.length]} data-len={lens[i % lens.length]} aria-hidden="true"></span>
  ))}
  <a class="tag tag--yours" href={`mailto:${site.email}`} data-hang="contact-wall" data-node="6,1" data-len="2.4" data-color="pink" tabindex="-1" aria-hidden="true">
    <span class="tag__kind">Yours</span>
  </a>
  <div class="contact__main">
    <h2 class="contact__title" data-split="lines">Tie the next one with me.</h2>
    <p class="contact__lede">{site.openTo}. Based in {site.location}.</p>
    <p class="contact__mail"><a class="roll" href={`mailto:${site.email}`}><span>{site.email}</span><span aria-hidden="true">{site.email}</span></a></p>
    <div class="contact__row">
      <a class="btn btn--pink" href={`mailto:${site.email}`} data-fill><span class="btn__fill" aria-hidden="true"></span>Email me</a>
      <a class="btn" href={site.resumePdf} download data-fill><span class="btn__fill" aria-hidden="true"></span>Download resume <span class="arrow" aria-hidden="true">↓</span></a>
    </div>
    <ul class="contact__links">
      {links.map((l) => <li><a class="link" href={l.href} rel="me noopener">{l.label}</a></li>)}
    </ul>
  </div>
  <div class="legal">
    <span>© 2026 {site.name}</span>
    <span>Set in Cabinet Grotesk and Switzer. Built with Astro and GSAP.</span>
    <a href="#main">Back to top</a>
  </div>
</footer>
